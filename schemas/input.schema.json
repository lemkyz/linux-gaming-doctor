{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linux-gaming-doctor.invalid/schemas/input.schema.json",
  "title": "Linux Gaming Doctor P08 Input Report",
  "type": "object",
  "required": [
    "schema_version",
    "phase",
    "read_only",
    "events",
    "hidraw",
    "uinput",
    "udev",
    "device_scope_batteries",
    "finding_count",
    "findings",
    "privacy"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "phase": {
      "const": "P08"
    },
    "read_only": {
      "const": true
    },
    "events": {
      "type": "object"
    },
    "hidraw": {
      "type": "object"
    },
    "uinput": {
      "type": "object"
    },
    "udev": {
      "type": "object"
    },
    "device_scope_batteries": {
      "type": "object"
    },
    "finding_count": {
      "type": "integer",
      "minimum": 0
    },
    "findings": {
      "type": "array"
    },
    "privacy": {
      "type": "object"
    }
  }
}
