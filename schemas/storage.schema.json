{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linux-gaming-doctor.invalid/schemas/storage.schema.json",
  "title": "Linux Gaming Doctor P09 Storage Report",
  "type": "object",
  "required": [
    "schema_version",
    "phase",
    "read_only",
    "host_filesystems",
    "steam_storage",
    "finding_count",
    "findings",
    "privacy"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "phase": {
      "const": "P09"
    },
    "read_only": {
      "const": true
    },
    "host_filesystems": {
      "type": "object"
    },
    "steam_storage": {
      "type": "object"
    },
    "finding_count": {
      "type": "integer",
      "minimum": 0
    },
    "findings": {
      "type": "array"
    },
    "privacy": {
      "type": "object"
    }
  }
}
