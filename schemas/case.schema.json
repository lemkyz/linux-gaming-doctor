{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linux-gaming-doctor.dev/schemas/case.schema.json",
  "title": "Linux Gaming Doctor canonical complaint case",
  "type": "object",
  "required": [
    "id", "title", "category", "symptom", "classification",
    "evidence_status", "probes", "mutation_policy", "verification"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^LGD-[0-9]{4}$"},
    "title": {"type": "string", "minLength": 8},
    "category": {
      "type": "string",
      "enum": [
        "launch_proton", "gpu_vulkan", "display_wayland", "input_controller",
        "audio", "performance", "storage_filesystem", "packaging_flatpak",
        "launcher", "anti_cheat_drm", "streaming_capture", "power_suspend",
        "mods", "steam_client", "game_specific"
      ]
    },
    "symptom": {"type": "string", "minLength": 8},
    "classification": {
      "type": "string",
      "enum": ["REPAIRABLE", "WORKAROUND", "UPSTREAM_BUG", "UNSUPPORTED_POLICY", "UNKNOWN"]
    },
    "evidence_status": {
      "type": "string",
      "enum": ["CONFIRMED", "REPORTED", "UNCONFIRMED"]
    },
    "source_hint": {"type": "string"},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "probes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
    "mutation_policy": {
      "type": "string",
      "enum": ["NONE", "TEMPORARY_ONLY", "REVERSIBLE"]
    },
    "verification": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
    "rollback": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
